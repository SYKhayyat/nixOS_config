# Nix build artifacts
result
result-*
.direnv/
.pre-commit-config.yaml

# Editor / OS cruft
*~
\#*\#
.DS_Store

# One-off dumps (regenerated with `just bundle`)
combined.txt


# Secrets that must never be committed in plaintext
# (sops-managed *.enc.yaml / *.sops.yaml ARE safe to commit)
secrets/*.plain
tokens.conf
rclone.conf

# Crash-telemetry droppings from sudo'd tools
.sentry-native/

# Agent state
.freebuff/

# Python bytecode (tools/bump-omnirush.py is run by every rebuild)
__pycache__/
*.pyc
